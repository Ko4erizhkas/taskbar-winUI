<Window
    x:Class="BarKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BarKit">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Своя область заголовка: за неё окно перетаскивается -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <TextBlock Text="BarKit — настройки панели задач" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4" MaxWidth="760" Margin="24,0,24,24">

                <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational"
                         Title="Подключение к панели задач…">
                    <InfoBar.ActionButton>
                        <Button x:Name="ReconnectButton" Content="Подключить заново" Click="OnReconnectClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- ===== Группировка ===== -->
                <TextBlock Text="Группировка значков" Style="{StaticResource Section}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Отделять запущенные приложения" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Запущенные приложения собираются в отдельную группу, закреплённые без открытых окон остаются в своей." />
                        </StackPanel>
                        <ToggleSwitch x:Name="GroupToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnSettingToggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Порядок групп" VerticalAlignment="Center" />
                        <ComboBox x:Name="GroupOrderBox" Grid.Column="1" MinWidth="280" SelectionChanged="OnSettingSelected">
                            <ComboBoxItem Content="Закреплённые, затем запущенные" />
                            <ComboBoxItem Content="Запущенные, затем закреплённые" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Линия-разделитель между группами" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="SeparatorToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnSettingToggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Зазор между группами, пикс." VerticalAlignment="Center" />
                        <Slider x:Name="GapSlider" Grid.Column="1" Width="280" Minimum="0" Maximum="48" StepFrequency="1"
                                ValueChanged="OnSettingSlider" />
                    </Grid>
                </Border>

                <!-- ===== Внешний вид ===== -->
                <TextBlock Text="Прозрачность панели" Style="{StaticResource Section}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Фон панели задач" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Работает при любом положении панели: снизу, сверху, слева или справа." />
                        </StackPanel>
                        <ComboBox x:Name="AppearanceBox" Grid.Column="1" MinWidth="280" SelectionChanged="OnSettingSelected">
                            <ComboBoxItem Content="Системный (не менять)" />
                            <ComboBoxItem Content="Полностью прозрачный" />
                            <ComboBoxItem Content="Полупрозрачный цвет" />
                            <ComboBoxItem Content="Акрил (размытие с оттенком)" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Цвет оттенка" />
                            <TextBlock Style="{StaticResource Hint}" Text="Для режимов «Полупрозрачный цвет» и «Акрил»." />
                        </StackPanel>
                        <Button Grid.Column="1" Padding="4">
                            <Border x:Name="TintSwatch" Width="56" Height="24" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="TintPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                 ColorChanged="OnTintColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Плотность оттенка, %" VerticalAlignment="Center" />
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Width="280" Minimum="0" Maximum="100" StepFrequency="1"
                                ValueChanged="OnSettingSlider" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Скрыть тонкую линию по краю панели" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="BorderToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnSettingToggled" />
                    </Grid>
                </Border>

                <!-- ===== Медиа ===== -->
                <TextBlock Text="Поле «Сейчас играет»" Style="{StaticResource Section}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Показывать на панели задач" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Название, исполнитель, обложка и кнопки управления для того, что сейчас воспроизводится (браузер, Spotify, плеер и т. д.)." />
                        </StackPanel>
                        <ToggleSwitch x:Name="MediaToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnSettingToggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Расположение" VerticalAlignment="Center" />
                        <ComboBox x:Name="MediaPositionBox" Grid.Column="1" MinWidth="280" SelectionChanged="OnSettingSelected">
                            <ComboBoxItem Content="В начале панели (слева / сверху)" />
                            <ComboBoxItem Content="По центру" />
                            <ComboBoxItem Content="В конце, перед треем (справа / снизу)" />
                            <ComboBoxItem Content="Сразу после значков приложений" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Отступ от точки привязки, пикс." />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Сдвигает поле, чтобы оно не перекрывало соседние элементы. Может быть отрицательным." />
                        </StackPanel>
                        <NumberBox x:Name="MediaOffsetBox" Grid.Column="1" Width="160" Minimum="-2000" Maximum="2000"
                                   SmallChange="4" LargeChange="20" SpinButtonPlacementMode="Inline"
                                   ValueChanged="OnSettingNumber" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Максимальная ширина текста, пикс." VerticalAlignment="Center" />
                        <Slider x:Name="MediaWidthSlider" Grid.Column="1" Width="280" Minimum="60" Maximum="480" StepFrequency="10"
                                ValueChanged="OnSettingSlider" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Показывать обложку" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="MediaArtToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnSettingToggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Показывать кнопки управления" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="MediaControlsToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnSettingToggled" />
                    </Grid>
                </Border>

                <!-- ===== Общее ===== -->
                <TextBlock Text="Общее" Style="{StaticResource Section}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Запускать вместе с Windows" />
                            <TextBlock Style="{StaticResource Hint}" Text="Приложение стартует свёрнутым в область уведомлений." />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutostartToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                      Toggled="OnAutostartToggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Диагностика" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Если после обновления Windows что-то перестало работать, сохраните дерево панели задач и пришлите файлы tree.txt и tap.log из папки с логами." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Сохранить дерево панели задач" Click="OnDumpTreeClick" />
                            <Button Content="Открыть папку с логами" Click="OnOpenLogsClick" />
                            <Button Content="Перезапустить Проводник" Click="OnRestartExplorerClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
